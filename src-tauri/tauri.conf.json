{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "pot",
    "version": "3.0.7",
    "identifier": "com.pot-app.desktop",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": false,
        "macOSPrivateApi": true,
        "windows": [
            {
                "title": "Daemon",
                "label": "daemon",
                "visible": false,
                "url": "daemon.html"
            }
        ],
        "security": {
            "csp": "default-src * data: ; img-src * 'self' asset: https: data: ; style-src * 'unsafe-inline'; worker-src 'self' blob: ; script-src * 'unsafe-eval';",
            "devCsp": "default-src * data: ; img-src * 'self' asset: https: data: ; style-src * 'unsafe-inline'; worker-src 'self' blob: ; script-src * 'unsafe-eval';",
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$CACHE/**",
                    "$CONFIG/**"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": false,
        "category": "Utility",
        "copyright": "GPLv3",
        "targets": "all",
        "longDescription": "A cross-platform text translation and ocr software",
        "shortDescription": "Pot App",
        "externalBin": [],
        "resources": [],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "linux": {
            "deb": {
                "depends": [
                    "libxdo-dev",
                    "libxcb1",
                    "libxrandr2",
                    "tesseract-ocr"
                ]
            },
            "rpm": {
                "depends": [
                    "libxdo-dev",
                    "libxcb1",
                    "libxrandr2",
                    "tesseract-ocr"
                ]
            }
        },
        "macOS": {
            "entitlements": null,
            "exceptionDomain": "",
            "frameworks": [],
            "providerShortName": null,
            "signingIdentity": null
        }
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/zjjxwhh/pot-desktop/releases/download/updater/update.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBRTQxQTNDQjM5QzQzM0EKUldRNlE1eXpQQnJrV21mM1Bram5LRlF6UDA3K0Jab2FYL2lZSWhXTE5McWs2NUdJS0dtYkd5VGMK"
        }
    }
}
